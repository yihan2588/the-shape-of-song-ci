      "authors": 7,
      "poems": [
        {
          "id": "guwendao-f8387e41225e",
          "poet": "卢炳",
          "label": null,
          "title": "减字木兰花·莎衫筠笠",
          "note": "",
          "tune": "减字木兰花",
          "text": "莎衫筠笠。正是村村农务急。绿水千畦,惭愧秧针出得齐。\n风斜雨细。麦欲黄时寒又至。馌妇耕夫,画作今年稔岁图。",
          "url": "https://www.guwendao.net/shiwenv_f8387e41225e.aspx"
        },
        {
          "id": "guwendao-d0a59659b632",
          "poet": "王炎",
          "label": null,
          "title": "南柯子·山冥云阴重",
          "note": "",
          "tune": "南柯子",
          "text": "山冥云阴重,天寒雨意浓。数枝幽艳湿啼红。莫为惜花惆怅对东风。\n蓑笠朝朝出,沟塍处处通。人间辛苦是三农。要得一犁水足望年丰。",
          "url": "https://www.guwendao.net/shiwenv_d0a59659b632.aspx"
        },
        {
          "id": "guwendao-82bccb42f25f",
          "poet": "范成大",
          "label": null,
          "title": "蝶恋花·春涨一篙添水面",
          "note": "",
          "tune": "蝶恋花",
          "text": "春涨一篙添水面。芳草鹅儿,绿满微风岸。画舫夷犹湾百转。横塘塔近依前远。\n江国多寒农事晚。村北村南,谷雨才耕遍。秀麦连冈桑叶贱。看看尝面收新茧。",
          "url": "https://www.guwendao.net/shiwenv_82bccb42f25f.aspx"
        },
        {
          "id": "guwendao-1cef42b81ca4",
          "poet": "周邦彦",
          "label": "婉约派",
          "title": "虞美人·疏篱曲径田家小",
          "note": "",
          "tune": "虞美人",
          "text": "疏篱曲径田家小。云树开清晓。天寒山色有无中。野外一声钟起、送孤蓬。\n添衣策马寻亭堠。愁抱惟宜酒。菰蒲睡鸭占陂塘。纵被行人惊散、又成双。",
          "url": "https://www.guwendao.net/shiwenv_1cef42b81ca4.aspx"
        },
        {
          "id": "guwendao-20ee2cbac808",
          "poet": "苏轼",
          "label": "豪放派",
          "title": "浣溪沙·簌簌衣巾落枣花",
          "note": "",
          "tune": "浣溪沙",
          "text": "簌簌衣巾落枣花,村南村北响缲车,牛衣古柳卖黄瓜。\n酒困路长惟欲睡,日高人渴漫思茶。敲门试问野人家。",
          "url": "https://www.guwendao.net/shiwenv_20ee2cbac808.aspx"
        },
        {
          "id": "guwendao-03e80e28a0c2",
          "poet": "辛弃疾",
          "label": "豪放派",
          "title": "清平乐·村居",
          "note": "",
          "tune": "清平乐",
          "text": "茅檐低小,溪上青青草。醉里吴音相媚好,白发谁家翁媪?\n大儿锄豆溪东,中儿正织鸡笼。最喜小儿亡赖,溪头卧剥莲蓬。",
          "url": "https://www.guwendao.net/shiwenv_03e80e28a0c2.aspx"
        },
        {
          "id": "guwendao-f090d65212f4",
          "poet": "辛弃疾",
          "label": "豪放派",
          "title": "西江月·夜行黄沙道中",
          "note": "",
          "tune": "西江月",
          "text": "明月别枝惊鹊,清风半夜鸣蝉。稻花香里说丰年,听取蛙声一片。\n七八个星天外,两三点雨山前。旧时茅店社林边,路转溪桥忽见。",
          "url": "https://www.guwendao.net/shiwenv_f090d65212f4.aspx"
        },
        {
          "id": "guwendao-8005cc89b888",
          "poet": "秦观",
          "label": "婉约派",
          "title": "行香子·树绕村庄",
          "note": "",
          "tune": "行香子",
          "text": "树绕村庄,水满陂塘。倚东风,豪兴徜徉。小园几许,收尽春光。有桃花红,李花白,菜花黄。\n远远围墙,隐隐茅堂。飏青旗,流水桥旁。偶然乘兴,步过东冈。正莺儿啼,燕儿舞,蝶儿忙。",
          "url": "https://www.guwendao.net/shiwenv_8005cc89b888.aspx"
        }
      ]
    },
